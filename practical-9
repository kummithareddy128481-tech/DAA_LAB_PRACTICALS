#include <iostream>
#include <vector>
#include <climits>
#include <chrono>
using namespace std;

int main() {
    int n;
    cout << "Enter number of vertices: ";
    cin >> n;

    vector<vector<int>> graph(n, vector<int>(n));

    cout << "Enter adjacency matrix:\n";
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            cin >> graph[i][j];
        }
    }

    vector<bool> visited(n, false);
    visited[0] = true;

    int edges = 0, totalCost = 0;

    cout << "\nEdges in Minimum Spanning Tree:\n";

    // Start measuring execution time
    auto start = chrono::high_resolution_clock::now();

    while (edges < n - 1) {
        int minWeight = INT_MAX;
        int u = -1, v = -1;

        for (int i = 0; i < n; i++) {
            if (visited[i]) {
                for (int j = 0; j < n; j++) {
                    if (!visited[j] && graph[i][j] != 0 &&
                        graph[i][j] < minWeight) {
                        minWeight = graph[i][j];
                        u = i;
                        v = j;
                    }
                }
            }
        }

        if (u == -1) {
            cout << "Graph is disconnected!\n";
            return 0;
        }

        cout << u << " - " << v
             << " : " << minWeight << '\n';

        visited[v] = true;
        totalCost += minWeight;
        edges++;
    }

    // Stop measuring execution time
    auto end = chrono::high_resolution_clock::now();

    // Calculate execution time
    chrono::duration<double, milli> executionTime = end - start;

    cout << "Total MST cost: " << totalCost << '\n';

    cout << "Execution Time: "
         << executionTime.count()
         << " milliseconds\n";

    return 0;
}
